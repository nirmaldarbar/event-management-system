# Copy this file to .env and adjust
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/event_management
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:3000

